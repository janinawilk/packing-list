<div class="level">
  <div class="level-left">
    <h1 class="title">Categories</h1>
  </div>
  <div class="level-right">
    <%= link_to "New Category", new_category_path, class: "button is-primary" %>
  </div>
</div>

<% if @categories.any? %>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable is-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Items</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.name %></td>
            <td><span class="tag"><%= category.items.count %></span></td>
            <td class="has-text-right">
              <%= link_to "Edit", edit_category_path(category), class: "button is-small is-link is-light" %>
              <%= button_to "Delete", category_path(category), method: :delete,
                    class: "button is-small is-danger is-light",
                    form: { data: { turbo_confirm: "Delete #{category.name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="has-text-centered py-6">
    <p class="is-size-5 has-text-grey">No categories yet.</p>
  </div>
<% end %>
