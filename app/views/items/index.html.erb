<div class="level">
  <div class="level-left">
    <h1 class="title">Items</h1>
  </div>
  <div class="level-right">
    <%= link_to "New Item", new_item_path, class: "button is-primary" %>
  </div>
</div>

<% if @items.any? %>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable is-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Tags</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td><%= item.name %></td>
            <td><span class="tag is-info is-light"><%= item.category.name %></span></td>
            <td>
              <div class="tags">
                <% item.tags.each do |tag| %>
                  <span class="tag is-primary is-light is-small"><%= tag.name %></span>
                <% end %>
              </div>
            </td>
            <td class="has-text-right">
              <%= link_to "Edit", edit_item_path(item), class: "button is-small is-link is-light" %>
              <%= button_to "Delete", item_path(item), method: :delete,
                    class: "button is-small is-danger is-light",
                    form: { data: { turbo_confirm: "Delete #{item.name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="has-text-centered py-6">
    <p class="is-size-5 has-text-grey">No items yet.</p>
  </div>
<% end %>
