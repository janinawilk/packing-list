<div class="page-header">
  <h1 class="title mb-0">Tags</h1>
  <%= link_to "New Tag", new_tag_path, class: "button is-primary" %>
</div>

<% if @tags.any? %>
  <div class="resource-list">
    <% @tags.each do |tag| %>
      <div class="resource-card">
        <div class="resource-card-left">
          <span class="resource-chip <%= tag_color_class(tag.name) %>"><%= tag_icon(tag.name) %> <%= tag.name %></span>
          <span class="resource-count"><%= tag.items.count %> items</span>
        </div>
        <div class="item-card-actions">
          <%= link_to edit_tag_path(tag), class: "item-action-btn", title: "Edit" do %>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M11.5 1.5l3 3L5 14H2v-3L11.5 1.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% end %>
          <%= button_to tag_path(tag), method: :delete,
                class: "item-action-btn item-action-delete",
                title: "Delete",
                form: { data: { turbo_confirm: "Usunąć tag #{tag.name}?" } } do %>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M5 4V2h6v2M6 7v5M10 7v5M3 4l1 10h8l1-10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>Brak tagów.</p>
    <%= link_to "Dodaj pierwszy tag", new_tag_path, class: "button is-primary mt-3" %>
  </div>
<% end %>
