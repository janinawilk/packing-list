<div class="page-header">
  <h1 class="title mb-0">Tags</h1>
  <%= link_to "New Tag", new_tag_path, class: "button is-primary" %>
</div>

<% if @tags.any? %>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable is-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Items</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @tags.each do |tag| %>
          <tr>
            <td><%= tag.name %></td>
            <td><span class="tag"><%= tag.items.count %></span></td>
            <td class="has-text-right">
              <%= link_to "Edit", edit_tag_path(tag), class: "button is-small is-link is-light" %>
              <%= button_to "Delete", tag_path(tag), method: :delete,
                    class: "button is-small is-danger is-light",
                    form: { data: { turbo_confirm: "Delete #{tag.name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="has-text-centered py-6">
    <p class="is-size-5 has-text-grey mb-4">No tags yet.</p>
    <%= link_to "Create your first tag", new_tag_path, class: "button is-primary" %>
  </div>
<% end %>
