<%= turbo_frame_tag "trip-progress" do %>
  <% total = trip.trip_items.count %>
  <% packed = trip.trip_items.where(is_packed: true).count %>
  <% if total > 0 %>
    <div class="mb-5">
      <div class="level mb-2">
        <div class="level-left">
          <span class="has-text-grey"><%= packed %> / <%= total %> packed</span>
        </div>
        <div class="level-right">
          <span class="has-text-grey"><%= ((packed.to_f / total) * 100).round %>%</span>
        </div>
      </div>
      <progress class="progress is-primary" value="<%= packed %>" max="<%= total %>"><%= packed %>/<%= total %></progress>
    </div>
  <% end %>
<% end %>
