<%= turbo_frame_tag "trip-progress" do %>
  <% total = trip.trip_items.count %>
  <% packed = trip.trip_items.where(is_packed: true).count %>
  <% pct = total > 0 ? ((packed.to_f / total) * 100).round : 0 %>
  <div class="trip-progress">
    <div class="progress-circle" style="--progress: <%= pct %>">
      <svg viewBox="0 0 36 36">
        <path class="progress-bg"
          d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
        <path class="progress-fill"
          d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
          stroke-dasharray="<%= pct %>, 100" />
      </svg>
      <span class="progress-pct"><%= pct %>%</span>
    </div>
    <span class="progress-label"><%= packed %> of <%= total %> packed</span>
  </div>
<% end %>
